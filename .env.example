# ==============================================================================
# MEDOVIK MÉRIDA — Variables de Entorno (Vercel / Local)
# ==============================================================================
# NOTA PARA VERCEL DEMO (SIN DOMINIO):
# El proyecto funciona 100% "Zero-Config" en Modo Catálogo Demo incluso sin
# definir variables de entorno, cargando las 3 recetas maestras × 3 formatos
# desde el catálogo curado local y generando pedidos hacia WhatsApp (+52 999 903 0512).
# ==============================================================================

# 1. Identidad de tienda y URL base (en Vercel sin dominio propio usa tu *.vercel.app)
NEXT_PUBLIC_STORE_SLUG=medovik-merida
NEXT_PUBLIC_SITE_URL=https://medovik-merida.vercel.app

# 2. Supabase (Opcional en Modo Demo · Requerido para Panel Admin y persistencia en DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Stripe México - Pagos en MXN y Anticipo del 50% (Opcional · Fase 2 Transaccional)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
